---
// src/components/PortfolioHero.astro
---
<section class="relative bg-gradient-to-br from-white via-gray-50 to-purple-50 py-24 md:py-32 overflow-hidden">
  <!-- Container for the text content -->
  <div class="relative max-w-7xl mx-auto px-8 z-10 text-center">
    
    <!-- "Portfolio" Tag -->
    <span class="inline-block bg-green-100 text-green-800 border border-green-200 rounded-md px-4 py-1 text-sm font-medium">
      Portfolio
    </span>

    <!-- Main Heading -->
    <h1 class="mt-6 text-4xl md:text-6xl font-extrabold text-gray-900 leading-tight">
      Our Work: Intelligent Solutions, <br>
      <span class="text-orange-500">Real Impact</span>
    </h1>

    <!-- Subheading Paragraph -->
    <p class="mt-6 max-w-3xl mx-auto text-lg text-gray-600">
      We partner with global businesses to design, build, and scale digital solutions that make a difference. Explore some of our success stories.
    </p>

  </div>
  
  <!-- Decorative Background Shapes -->
  <!-- These are positioned relative to the main section -->
  <div class="absolute top-1/4 left-10 w-6 h-6 bg-red-400 opacity-75 rounded-sm -z-0"></div>
  <div class="absolute bottom-1/4 left-20 w-8 h-8 bg-blue-400 opacity-75 rounded-md -z-0"></div>
  <div class="absolute top-20 right-20 w-10 h-10 bg-purple-400 opacity-75 rounded-full -z-0"></div>
  <div class="absolute bottom-1/3 right-16 w-8 h-8 border-2 border-green-400 opacity-75 rounded-md transform rotate-45 -z-0"></div>
</section>