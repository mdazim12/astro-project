---
// src/components/HeroSection.astro
---
<section class="relative bg-white py-20 md:py-28 overflow-hidden">
  <div class="relative max-w-7xl mx-auto px-8 z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight">
          AI, EdTech & SaaS Solutions
          <span class="block text-orange-500">That Scale Globally</span>
        </h1>
        <p class="mt-6 text-lg text-gray-600">
          We help startups, enterprises, and education providers build future-ready platforms—trusted by <strong class="font-semibold text-gray-800">ACCA, British Council,</strong> and 100K+ users worldwide.
        </p>
        
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#" class="bg-red-500 text-white font-semibold py-3 px-8 rounded-lg shadow-lg hover:bg-red-600 transition-all transform hover:-translate-y-1">
            Start Your Project →
          </a>
          <a href="#" class="bg-white text-gray-700 font-semibold py-3 px-8 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors">
            Book a Free Consultation
          </a>
        </div>

        <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
          <div>
            <p class="text-3xl font-bold text-orange-500">10+</p>
            <p class="text-gray-500">Years Experience</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-purple-500">6+</p>
            <p class="text-gray-500">Countries</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-green-500">27+</p>
            <p class="text-gray-500">Long-Term Projects</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-blue-500">24/7</p>
            <p class="text-gray-500">Support</p>
          </div>
        </div>
      </div>

      <div class="hidden lg:block">
        <div class="bg-white p-4 rounded-2xl shadow-2xl">
           <img src="https://nerddevs.com/wp-content/uploads/2024/07/nerddevs-hero-image.png" alt="Platform screenshots" class="rounded-xl">
        </div>
      </div>
    </div>
  </div>
  
  <div class="absolute top-10 left-5 w-8 h-8 bg-blue-200 rounded-full opacity-50 -z-0 blur-sm"></div>
  <div class="absolute top-20 right-10 w-12 h-12 bg-purple-200 rounded-full opacity-50 -z-0"></div>
  <div class="absolute bottom-20 left-1/4 w-6 h-6 bg-yellow-200 rounded-full opacity-50 -z-0"></div>
  <div class="absolute bottom-10 right-20 w-10 h-10 bg-green-200 rounded-full opacity-50 -z-0 blur-sm"></div>
</section>